          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT count(*)::int AS \"Late\"\nFROM assignments a\nJOIN courses c ON c.id = a.course_id\nJOIN children ch ON ch.id = c.child_id\nJOIN latest_assignment_state s ON s.assignment_id = a.id\nWHERE s.status = 'assigned' AND c.active AND a.due_at < now()\n  AND ch.display_name IN (${child:sqlstring})\n",
          "refId": "A"
        }
      ],
      "title": "Late",
      "type": "stat"
    },
