      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "schoolhouse"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT ch.display_name AS \"Child\",\n       count(*) AS \"Known\",\n       count(*) FILTER (WHERE a.due_at IS NOT NULL) AS \"Dated\",\n       count(*) FILTER (WHERE a.points_possible IS NOT NULL) AS \"Pointed\",\n       count(*) FILTER (WHERE a.due_at > now()) AS \"Still ahead\"\nFROM assignments a\nJOIN courses c ON c.id = a.course_id\nJOIN children ch ON ch.id = c.child_id\nWHERE c.active AND ch.display_name IN (${child:sqlstring})\nGROUP BY ch.display_name\nORDER BY ch.display_name\n",
          "refId": "A"
        }
      ],
      "title": "Coverage",
      "type": "table"
    }
  ],
