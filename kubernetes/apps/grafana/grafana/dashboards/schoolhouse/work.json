              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Basis"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "inferred": {
                        "color": "#F79009",
                        "index": 1,
                        "text": "inferred"
                      },
                      "observed": {
