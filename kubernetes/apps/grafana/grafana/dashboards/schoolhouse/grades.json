      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "schoolhouse"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT ch.display_name AS \"Child\",\n       c.title AS \"Course\",\n       COALESCE(s.display_name, NULLIF(c.teacher, ''), '—') AS \"Teacher\",\n       g.percent AS \"Percent\",\n       NULLIF(g.letter, '') AS \"Letter\",\n       g.observed_at AT TIME ZONE 'America/New_York' AS \"As of\"\nFROM latest_course_grade g\nJOIN courses c ON c.id = g.course_id\nJOIN children ch ON ch.id = c.child_id\nLEFT JOIN staff s ON s.schoology_uid = c.teacher_uid\nWHERE c.active\n  AND ch.display_name IN (${child:sqlstring})\n  AND c.title IN (${course:sqlstring})\nORDER BY ch.display_name, c.title\n",
          "refId": "A"
        }
      ],
      "title": "Where each course stands",
      "type": "table"
    }
