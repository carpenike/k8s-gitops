      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "schoolhouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT g.observed_at AS time,\n       g.percent::double precision AS value,\n       ch.display_name || ' · ' || c.title AS metric\nFROM course_grades g\nJOIN courses c ON c.id = g.course_id\nJOIN children ch ON ch.id = c.child_id\nWHERE g.percent IS NOT NULL\n  AND c.active\n  AND ch.display_name IN (${child:sqlstring})\n  AND c.title IN (${course:sqlstring})\n  AND $__timeFilter(g.observed_at)\nORDER BY g.observed_at\n",
          "refId": "A"
        }
      ],
      "title": "How each grade has moved",
      "type": "timeseries"
    },
