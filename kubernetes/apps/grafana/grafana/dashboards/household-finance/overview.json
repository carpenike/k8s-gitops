          "rawQuery": true,
          "rawSql": "SELECT\n  date::timestamp AT TIME ZONE 'America/New_York' AS time,\n  CASE\n    WHEN amount IS NULL THEN label\n    ELSE label || ' (' || to_char(amount, 'FM$999,999,999,990.00') || ')'\n  END AS text,\n  type AS tags\nFROM household_finance.events\nWHERE $__timeFilter(date::timestamp)\nORDER BY date\n",
          "refId": "FinanceEvents"
        }
      }
    ]
  },
