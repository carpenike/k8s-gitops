#!/bin/sh
# k8s-gitops: Claude Code's apiKeyHelper. Prints this bot's Claude Code
# LiteLLM key (Secret claude-code-litellm, a key of its own with its own
# budget, not the agent's) and nothing else.
key=/etc/hermes-claude-code/litellm_key
if [ ! -s "$key" ]; then
  echo "No LiteLLM key at $key: is CLAUDE_CODE_ENABLED on for this bot?" >&2
  exit 1
fi
exec cat "$key"
