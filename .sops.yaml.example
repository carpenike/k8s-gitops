# Copy to .sops.yaml after generating a NEW age key locally.
# Do not reuse a key from the archived tree. Do not commit the private key.
# The recipient below is a marker, not a key.
creation_rules:
  - path_regex: talos/.*\.sops\.ya?ml
    mac_only_encrypted: true
    age: AGE_RECIPIENT_PLACEHOLDER
  - path_regex: (bootstrap|kubernetes)/.*\.sops\.ya?ml
    encrypted_regex: "^(data|stringData)$"
    mac_only_encrypted: true
    age: AGE_RECIPIENT_PLACEHOLDER
stores:
  yaml:
    indent: 2
