{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#10.0.1"],
  schedule: ["every weekend"],
  // Plan pin for the Renovate release that opened this config: 44.188.2.
  // The GitHub App version is selected in GitHub, not in this file.
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
      overrideDatasource: "github-releases",
    },
    {
      description: "Prometheus Operator CRDs move with kube-prometheus-stack. The CRD chart appVersion must match the operator appVersion in kube-prometheus-stack before merging.",
      groupName: "kube-prometheus-stack",
      matchDatasources: ["docker"],
      matchPackageNames: ["/prometheus-operator-crds/", "/kube-prometheus-stack/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Actions Runner Controller charts stay on one version.",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/gha-runner-scale-set-controller/",
        "/gha-runner-scale-set/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Hindsight: the chart (kubernetes/apps/hermes-memory), images/hindsight's base image and HINDSIGHT_VERSION in hindsight-image.yaml move together. The built image ghcr.io/carpenike/hindsight follows in the self-built images PR once the merge has rebuilt it; see docs/apps/hermes-memory.md.",
      groupName: "hindsight",
      matchDatasources: ["docker"],
      matchPackageNames: ["/vectorize-io\\/charts\\/hindsight$/", "/vectorize-io\\/hindsight-api$/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Hermes: images/hermes-agent's base image and HERMES_VERSION in both hermes-*-image.yaml workflows move together. The v2026.* tags are an older calendar scheme, not newer releases.",
      groupName: "hermes",
      matchDatasources: ["docker"],
      matchPackageNames: ["/nousresearch\\/hermes-agent$/"],
      allowedVersions: "/^v\\d{1,3}\\.\\d+\\.\\d+$/",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
      prBodyNotes: [
        "Before merging, re-vendor `images/hermes-screen/Dockerfile` from upstream `docker/sandbox-desktop.Dockerfile` at the new tag, keeping the `k8s-gitops:` changes, and read the release notes against docs/apps/hermes.md (\"Updating the images\").",
      ],
    },
    {
      description: "Self-built images (images/, ghcr.io/carpenike): each workflow moves a floating version tag on rebuild, and the manifests pin it by digest. One PR re-pins all of them after a rebuild.",
      groupName: "self-built images",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^ghcr\\.io\\/carpenike\\//"],
      group: {
        commitMessageTopic: "{{{groupName}}}",
      },
    },
    {
      description: "cua-driver (images/hermes-screen): trycua/cua is a monorepo, so only cua-driver-rs-v<x.y.z> releases count. Upstream marks every one a prerelease, so ignoreUnstable is off.",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["trycua/cua"],
      extractVersion: "^cua-driver-rs-v(?<version>\\d+\\.\\d+\\.\\d+)$",
      ignoreUnstable: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
